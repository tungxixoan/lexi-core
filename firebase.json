{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "lexi-core",
          "appId": "1:243190098866:android:257f5070c7049c6dddd2ab",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
